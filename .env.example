# ============================================================
# .env.example — Safe template (copy to .env and fill values)
# NEVER commit the real .env file to version control
# ============================================================

# ── OpenAQ v3 API ─────────────────────────────────────────
# Get your free key at: https://explore.openaq.org/developers
OPENAQ_API_KEY=your_openaq_api_key_here

# ── Flask ─────────────────────────────────────────────────
FLASK_SECRET_KEY=change_me_to_a_long_random_string
FLASK_DEBUG=false

# ── Background Scheduler ──────────────────────────────────
# Set to "true" to enable automatic background data ingestion
ENABLE_SCHEDULER=false
SCHEDULER_INTERVAL_MINUTES=30

# ── AQI Conversion Standard ───────────────────────────────
# Options: "true" = use official EPA/CPCB breakpoints
#          "false" = use legacy linear approximation (default)
USE_PROPER_AQI_CONVERSION=false

# ── Database (SQLite path, change for production) ─────────
# Default: data/air_quality.db (relative to project root)
DATABASE_URL=sqlite:///data/air_quality.db
